# Kalshi API Configuration
KALSHI_API_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
KALSHI_ENV=demo
# Options: "demo" (https://demo-api.kalshi.co) or "production" (https://api.elections.kalshi.com)

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/polybot

# Telegram Notifications
TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Engine Mode (paper | live | backtest)
ENGINE_MODE=paper

# Capital (for paper trading virtual balance, in cents)
PAPER_STARTING_CAPITAL_CENTS=10000

# Logging
LOG_LEVEL=INFO

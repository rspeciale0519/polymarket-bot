# ============================================================
# PolyBot Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# The engine reads these on startup.
# ============================================================

# --- Engine Mode ---
# paper = simulated trades (start here)
# live  = real money on Kalshi
ENGINE_MODE=paper

# --- Kalshi API (required for live trading, optional for paper) ---
# Get your API key at https://kalshi.com/account/profile → Settings → API
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_ENV=demo

# --- Telegram Notifications (optional) ---
# Create a bot via @BotFather on Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paper Trading ---
# Starting virtual balance in cents (10000 = $100.00)
PAPER_STARTING_CAPITAL_CENTS=10000

# --- Logging ---
LOG_LEVEL=INFO
